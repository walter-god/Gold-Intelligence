# ==============================================================================
# AUREX // Gold Intelligence — Production Environment Configuration (.env.example)
# ==============================================================================

# 1. CORE PLATFORM & RUNTIME
# ------------------------------------------------------------------------------
# Port for the Node/Express server (fixed to 3000 in Cloud Run container)
PORT=3000
# Environment mode: development | production
NODE_ENV=development
# APP_URL: The public URL where this applet is hosted (injected by Cloud Run)
APP_URL=

# 2. AI INTELLIGENCE & QUANTITATIVE ANALYST
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Server-side secret for Google Gemini API models (e.g. gemini-3.8-flash)
# Configured via the Secrets / Settings panel in Google AI Studio. Never commit actual key.
GEMINI_API_KEY=

# 3. XAUUSD MARKET DATA INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Provider identifier: HFM_MT5 | BINANCE_GOLD | GOLD_API | TWELVE_DATA | METALS_API | CUSTOM
XAUUSD_DATA_PROVIDER=HFM_MT5
# Optional API Key for commercial gold/metals feed providers (e.g. GoldAPI.io)
XAUUSD_API_KEY=
# WebSocket stream URL for sub-second real-time gold tick streaming
XAUUSD_STREAM_URL=wss://stream.binance.com:9443/ws/paxgusdt@bookTicker
# REST endpoint for 24h market metrics and snapshot fallback
XAUUSD_REST_URL=https://api.binance.com/api/v3/ticker/24hr?symbol=PAXGUSDT

# 4. BROKER BRIDGE & EXECUTION GATEWAY (HFM / MT5)
# ------------------------------------------------------------------------------
# Institutional broker gateway bridge endpoint (MT5 / FIX 4.4 / cTrader)
BROKER_FIX_GATEWAY_URL=http://0.0.0.0:3000/api/mt5/bridge
# Broker Company & Regulated Entity
BROKER_COMPANY_NAME="HF Markets (SV) Ltd"
# Target broker server name
BROKER_SERVER_NAME="HFMarketsGlobal-Demo"
# Broker account identifier or login number
BROKER_ACCOUNT_ID="49711913"
# Broker trading account password (kept server-side in .env for MT5 bridge authentication)
BROKER_ACCOUNT_PASSWORD=

# 5. SERVER-SIDE INSTITUTIONAL RISK CONTROLS
# ------------------------------------------------------------------------------
# Maximum allowed risk percentage per individual trade
RISK_MAX_EQUITY_RISK_PERCENT=2.0
# Hard circuit breaker daily maximum drawdown in USD before order locks
RISK_MAX_DAILY_DRAWDOWN_USD=2500.00
# Maximum cumulative open position lots
RISK_HARD_MAX_OPEN_LOTS=10.0

# 6. CLIENT-SIDE (VITE) RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Application branding and display title in UI
VITE_APP_NAME="AUREX // Gold Intelligence"
# Default starting chart timeframe (1M, 5M, 15M, 30M, 1H, 4H, 1D)
VITE_DEFAULT_TIMEFRAME=5M
# Enable WebGL hardware acceleration for 3D Bullion Scene
VITE_ENABLE_3D_ACCELERATION=true
